{
  "name": "GamePush-Plugin",
  "version": "1.2.0",
  "description": "自动监控游戏版本更新并推送通知，支持 Miao-Yunzai、TRSS-Yunzai、MangoCat-Yunzai、JiuLi、Karin、Yunzai-NG 六框架",
  "main": "index.js",
  "author": "rainbowwarmth",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "format": "prettier --write \"./**/*.{js,vue}\"",
    "lint": "eslint --ext .js .",
    "fix": "eslint --fix --ext .js && npm run format"
  },
  "repository": {
    "type": "git",
    "url": "https://gitcode.com/rainbowwarmth/GamePush-Plugin.git"
  },
  "keywords": [
    "yunzai",
    "miao-yunzai",
    "trss-yunzai",
    "mangocat-yunzai",
    "jiuli",
    "karin",
    "yunzai-ng",
    "gamepush"
  ],
  "dependencies": {
    "chokidar": "^4.0.3",
    "node-fetch": "^3.3.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-prettier": "^5.5.0",
    "eslint-plugin-promise": "^6.6.0",
    "prettier": "^3.6.2"
  },
  "karin": {
    "web": "./web.config.js",
    "apps": [
      "apps"
    ],
    "static": [
      "resources"
    ],
    "files": [
      "config"
    ]
  },
  "imports": {
    "#GamePush.lib": "./lib/index.js",
    "#GamePush.model": "./model/index.js",
    "#GamePush.model/commands": "./model/commands.js",
    "#GamePush.model/tasks": "./model/tasks.js",
    "#GamePush.model/util": "./model/util.js",
    "#GamePush.components": "./components/index.js",
    "#GamePush.runtime": "./lib/runtime/index.js",
    "#GamePush.runtime/detect": "./lib/runtime/detect.js",
    "#GamePush.runtime/define": "./lib/runtime/define.js",
    "#GamePush.runtime/lifecycle": "./lib/runtime/lifecycle.js",
    "#GamePush.registry": "./lib/runtime/registry/index.js",
    "#GamePush.registry/app-base": "./lib/runtime/registry/app-base.js",
    "#GamePush.panels": "./lib/runtime/panels/index.js",
    "#GamePush.panels/schema": "./lib/runtime/panels/schema.js",
    "#GamePush.panels/guoba": "./lib/runtime/panels/guoba.js",
    "#GamePush.panels/karin-web": "./lib/runtime/panels/karin-web.js",
    "#GamePush.panels/yunzai-ng": "./lib/runtime/panels/yunzai-ng.js"
  }
}
